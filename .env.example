# Copy to .env, fill in with any editor, then check with: powershell -ExecutionPolicy Bypass -File scripts\setup-env.ps1
# Never commit .env.

# --- Needed now (Phase 1) ---
# Alpaca PAPER key pair (used for data and by the Alpaca MCP server)
ALPACA_DATA_KEY=
ALPACA_DATA_SECRET=
# Trading keys: used ONLY by the risk gateway. Paper: may reuse the data keys.
# Live: a separate live-account key pair, set only on the production host.
ALPACA_TRADE_KEY=
ALPACA_TRADE_SECRET=
ALPACA_TRADE_PAPER=true
# Named TRADER_ so it never collides with Claude Code's own ANTHROPIC_API_KEY
TRADER_ANTHROPIC_API_KEY=
# Not a key: the SEC requires a descriptive User-Agent with contact info
SEC_USER_AGENT="trader-research your-email@example.com"

# --- Later ---
# P3: one month of Massive Starter for the bulk history download (D3)
MASSIVE_API_KEY=
# --- Needed for FRED (free: https://fredaccount.stlouisfed.org/apikeys) ---
FRED_API_KEY=
# P4: alerts via ntfy.sh (pick an unguessable topic name)
NTFY_TOPIC=
# Optional ntfy access token (tk_...) if your account/topic requires auth
NTFY_TOKEN=
